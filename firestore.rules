rules_version = '2';

// Reglas de Firestore para los comentarios de Café Con Dos.
// Si usas el mismo proyecto de Firebase que LPBLSA, NO reemplaces sus reglas:
// copia solo el bloque "match /ccd_comentarios/{id} { ... }" dentro del
// "match /databases/{database}/documents { ... }" que ya existe.

service cloud.firestore {
  match /databases/{database}/documents {

    match /ccd_comentarios/{id} {
      // Cualquiera puede leer los comentarios.
      allow read: if true;

      // Cualquiera puede crear un comentario, pero solo con estos campos,
      // con tamaños razonables y con la hora del servidor.
      allow create: if request.resource.data.keys().hasOnly(['post', 'nombre', 'texto', 'fecha'])
        && request.resource.data.post is string
        && request.resource.data.post.size() > 0
        && request.resource.data.post.size() <= 100
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 2
        && request.resource.data.texto.size() <= 1500
        && request.resource.data.fecha == request.time;

      // Nadie puede editar ni borrar desde el sitio.
      // Para borrar uno, hazlo desde la consola de Firebase.
      allow update, delete: if false;
    }
  }
}
