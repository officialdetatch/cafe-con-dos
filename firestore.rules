rules_version = '2';

// Reglas de Firestore para los comentarios de Café Con Dos.
// Si usas el mismo proyecto de Firebase que otro sitio, NO reemplaces sus reglas:
// copia solo los bloques "match /ccd_comentarios/{id}" y "match /ccd_admins/{email}"
// dentro del "match /databases/{database}/documents { ... }" que ya existe.
//
// Quién puede moderar: los correos que tengan un documento en la colección
// "ccd_admins" (el id del documento ES el correo, en minúsculas). Se agregan y
// quitan a mano en la consola de Firebase, así los correos no quedan en GitHub.

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de moderadores. Cada quien solo puede leer su propio documento
    // (para saber si es moderador); nadie la puede listar ni cambiar desde afuera.
    match /ccd_admins/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }

    match /ccd_comentarios/{id} {
      // Cualquiera puede leer los comentarios.
      allow read: if true;

      // Cualquiera puede crear un comentario, pero solo con estos campos,
      // con tamaños razonables y con la hora del servidor.
      allow create: if request.resource.data.keys().hasOnly(['post', 'nombre', 'texto', 'fecha'])
        && request.resource.data.post is string
        && request.resource.data.post.size() > 0
        && request.resource.data.post.size() <= 100
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 2
        && request.resource.data.texto.size() <= 1500
        && request.resource.data.fecha == request.time;

      // Nadie puede editar un comentario.
      allow update: if false;

      // Solo los moderadores (con Google, correo verificado y en ccd_admins) pueden borrar.
      allow delete: if request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/ccd_admins/$(request.auth.token.email));
    }
  }
}
