{
  "name": "cafe-con-dos-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Editor de artículos de Café Con Dos (Sanity Studio)",
  "type": "module",
  "scripts": {
    "dev": "node sincronizar.mjs && sanity dev",
